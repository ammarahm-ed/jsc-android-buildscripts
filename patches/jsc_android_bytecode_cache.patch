+#include "config.h"
+#include "JSBytecodeCache.h"
+
+#include "APICast.h"
+#include "BytecodeCacheError.h"
+#include "CachedBytecode.h"
+#include "CachedTypes.h"
+#include "CodeCache.h"
+#include "Completion.h"
+#include "Exception.h"
+#include "JSCInlines.h"
+#include "JSGlobalObjectInlines.h"
+#include "OpaqueJSString.h"
+#include "SourceCode.h"
+#include "SourceCodeKey.h"
+#include "SourceOrigin.h"
+#include "SourceProvider.h"
+#include <wtf/FileHandle.h>
+#include <wtf/FileSystem.h>
+#include <wtf/MappedFileData.h>
+#include <wtf/NakedPtr.h>
+#include <wtf/URL.h>
+#include <wtf/text/MakeString.h>
+#include <wtf/text/WTFString.h>
+
+using namespace JSC;
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+
+namespace {
+
+// A program SourceProvider that can optionally carry a bytecode cache. When it
+// does, JSC's CodeCache picks the cache up through cachedBytecode() and skips
+// parsing/byte-compilation for this source. When it does not (generation path),
+// it behaves like a plain string program provider.
+class BytecodeCacheSourceProvider final : public SourceProvider {
+public:
+    static Ref<BytecodeCacheSourceProvider> create(const SourceOrigin& sourceOrigin, String sourceURL, const String& source, RefPtr<CachedBytecode> cachedBytecode)
+    {
+        return adoptRef(*new BytecodeCacheSourceProvider(sourceOrigin, WTFMove(sourceURL), source, WTFMove(cachedBytecode)));
+    }
+
+    unsigned hash() const final { return m_source.get().hash(); }
+    StringView source() const final { return m_source.get(); }
+    RefPtr<CachedBytecode> cachedBytecode() const final { return m_cachedBytecode; }
+
+private:
+    BytecodeCacheSourceProvider(const SourceOrigin& sourceOrigin, String&& sourceURL, const String& source, RefPtr<CachedBytecode>&& cachedBytecode)
+        : SourceProvider(sourceOrigin, WTFMove(sourceURL), String(), SourceTaintedOrigin::Untainted, TextPosition(), SourceProviderSourceType::Program)
+        , m_source(source.isNull() ? *StringImpl::empty() : *source.impl())
+        , m_cachedBytecode(WTFMove(cachedBytecode))
+    {
+    }
+
+    const Ref<StringImpl> m_source;
+    RefPtr<CachedBytecode> m_cachedBytecode;
+};
+
+static SourceCode makeBytecodeCacheProgramSourceCode(JSStringRef sourceURLRef, const String& source, RefPtr<CachedBytecode> cachedBytecode)
+{
+    auto sourceURL = sourceURLRef ? URL({ }, sourceURLRef->string()) : URL();
+    Ref<BytecodeCacheSourceProvider> provider = BytecodeCacheSourceProvider::create(SourceOrigin { sourceURL }, sourceURL.string(), source, WTFMove(cachedBytecode));
+    return SourceCode(WTFMove(provider), 1, 1);
+}
+
+static void storeBytecodeCacheError(JSStringRef* errorMessage, const String& message)
+{
+    if (errorMessage)
+        *errorMessage = OpaqueJSString::tryCreate(message).leakRef();
+}
+
+} // anonymous namespace
+
+extern "C" {
+
+bool JSWriteBytecodeCacheForProgram(JSContextRef ctx, JSStringRef sourceRef, JSStringRef sourceURLRef, const char* outputFilePath, JSStringRef* errorMessage)
+{
+    if (errorMessage)
+        *errorMessage = nullptr;
+    if (!ctx || !sourceRef || !outputFilePath) {
+        storeBytecodeCacheError(errorMessage, "Invalid arguments to JSWriteBytecodeCacheForProgram"_s);
+        return false;
+    }
+
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+
+    SourceCode sourceCode = makeBytecodeCacheProgramSourceCode(sourceURLRef, sourceRef->string(), nullptr);
+
+    auto handle = FileSystem::openFile(String::fromUTF8(outputFilePath), FileSystem::FileOpenMode::ReadWrite, FileSystem::FileAccessPermission::User);
+    if (!handle) {
+        storeBytecodeCacheError(errorMessage, "Could not open the bytecode cache file for writing"_s);
+        return false;
+    }
+
+    BytecodeCacheError cacheError;
+    RefPtr<CachedBytecode> cachedBytecode = generateProgramBytecode(vm, sourceCode, handle, cacheError);
+    if (cacheError.isValid() || !cachedBytecode || !cachedBytecode->size()) {
+        handle.truncate(0);
+        storeBytecodeCacheError(errorMessage, cacheError.isValid() ? makeString("Unable to generate bytecode cache: "_s, cacheError.message()) : "Bytecode generation produced no data"_s);
+        return false;
+    }
+
+    handle.flush();
+    return true;
+}
+
+JSValueRef JSEvaluateProgramWithBytecodeCacheFile(JSContextRef ctx, JSStringRef sourceRef, JSStringRef sourceURLRef, const char* cacheFilePath, JSValueRef thisObjectRef, bool* cacheRejected, JSValueRef* exception)
+{
+    if (cacheRejected)
+        *cacheRejected = false;
+    if (exception)
+        *exception = nullptr;
+
+    if (!ctx || !sourceRef || !cacheFilePath) {
+        if (cacheRejected)
+            *cacheRejected = true;
+        return nullptr;
+    }
+
+    JSGlobalObject* globalObject = toJS(ctx);
+    VM& vm = globalObject->vm();
+    JSLockHolder locker(vm);
+
+    auto handle = FileSystem::openFile(String::fromUTF8(cacheFilePath), FileSystem::FileOpenMode::Read);
+    if (!handle) {
+        if (cacheRejected)
+            *cacheRejected = true;
+        return nullptr;
+    }
+
+    auto mappedFile = handle.map(FileSystem::MappedFileMode::Private);
+    if (!mappedFile || !mappedFile->size()) {
+        if (cacheRejected)
+            *cacheRejected = true;
+        return nullptr;
+    }
+
+    Ref<CachedBytecode> cachedBytecode = CachedBytecode::create(WTFMove(*mappedFile));
+    SourceCode sourceCode = makeBytecodeCacheProgramSourceCode(sourceURLRef, sourceRef->string(), cachedBytecode.copyRef());
+
+    // Reject a stale or incompatible cache (different source or JSC cache
+    // version) without running anything, so the caller can fall back to source.
+    SourceCodeKey key = sourceCodeKeyForSerializedProgram(vm, sourceCode);
+    if (!isCachedBytecodeStillValid(vm, cachedBytecode.copyRef(), key, SourceCodeType::ProgramType)) {
+        if (cacheRejected)
+            *cacheRejected = true;
+        return nullptr;
+    }
+
+    NakedPtr<Exception> internalException;
+    JSValue thisValue = thisObjectRef ? toJS(globalObject, thisObjectRef) : jsUndefined();
+    JSValue result = evaluate(globalObject, sourceCode, thisValue, internalException);
+    if (internalException) {
+        if (exception)
+            *exception = toRef(globalObject, internalException->value());
+        return nullptr;
+    }
+
+    ASSERT(result);
+    return toRef(globalObject, result);
+}
+
+} // extern "C"
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
